# R session and history files
.Rhistory
.RData
.Rproj.user/
.Ruserdata

# OS / editor noise
.DS_Store
*.swp
.vscode/

# Output: PNGs are tracked (small enough; useful to view in repo).
# PDFs/CSVs still ignored — regenerate from code.
output/*.pdf
output/*.csv

# Processed data is regenerated by R/01_load_data.R — never track
data/processed/*.rds
data/processed/*.csv

# Keep folders in git even if empty
!output/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
